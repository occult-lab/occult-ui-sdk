{
  "name": "occult-api-ui",
  "version": "0.1.1",
  "private": false,
  "description": "Drop-in React components for the Occult API — natal charts, panchang, dashas, Human Design, numerology, tarot and more, rendered from live astrological data.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "topojson-client": "^3.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "world-atlas": "^2.0.2"
  },
  "keywords": [
    "astrology",
    "vedic",
    "human-design",
    "tarot",
    "numerology",
    "react",
    "occult-api"
  ],
  "license": "MIT",
  "homepage": "https://occultapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/occult-lab/occult-ui-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/occult-lab/occult-ui-sdk/issues"
  }
}
